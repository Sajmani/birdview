# Where an input that may not be redistributed would be fetched (tech.fetchRestrictedInputs).
# None is read today; the ignore stays so a stray copy of one, such as the retired ABA checklist,
# can never be committed.
/fetched/

# The built dataset is a build artifact, not a source file (tech.datasetNeverCommitted): it is
# reproducible from the committed inputs in one command.
/web/data/species.json

# Compiled binaries. Every command is named birdview-*, and `go build
# ./cmd/<name>` without -o drops the binary in the working directory -- which
# is how an 8.5 MB birdview-regions executable was committed once.
/birdview
/birdview-*
/dist/

# Editor and mutation-testing backups.
*.bak

.DS_Store
