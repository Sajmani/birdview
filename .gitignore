# Inputs fetched at build time and never redistributed (T-004).
# The ABA checklist is all-rights-reserved; Ricklefs 2017 is not openly licensed.
/fetched/

# The built dataset is a build artifact, not a source file (T-005): it carries
# values derived from the non-redistributable inputs above.
/web/data/species.json

# Compiled binaries. Every command is named birdview-*, and `go build
# ./cmd/<name>` without -o drops the binary in the working directory -- which
# is how an 8.5 MB birdview-regions executable was committed once.
/birdview
/birdview-*
/dist/

# Editor and mutation-testing backups.
*.bak

.DS_Store
