# Screenshot a BirdView page as a simulated user sees it.
#
#   usertests/tools/shot URL OUT.png [phone|laptop] [screens]
#
# phone is 390 CSS pixels wide, laptop 1280. screens is how many screenfuls
# from the top to capture (default 1), as if the reader scrolled. Chrome will
# not open a window narrower than 500 pixels, so the page is drawn in a frame
# of the right width.
set -euo pipefail
url=$1 out=$2 device=${3:-phone} screens=${4:-1}
case $device in
phone) w=390 h=844 ;;
laptop) w=1280 h=800 ;;
*) echo "device must be phone or laptop" >&2; exit 2 ;;
esac
H=$((h * screens))
chrome=${BIRDVIEW_CHROME:-"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"}
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
cat >"$dir/frame.html" <<EOF
<!doctype html><html><body style="margin:0;background:#fff">
<iframe src="$url" style="border:0;width:${w}px;height:${H}px"></iframe>
</body></html>
EOF
"$chrome" --headless --disable-gpu --hide-scrollbars --no-first-run --no-default-browser-check \
  --user-data-dir="$dir/profile" --window-size=$((w > 500 ? w : 500)),$H \
  --virtual-time-budget=6000 --screenshot="$out" "file://$dir/frame.html" >/dev/null 2>&1
echo "$out: $device, ${w}x${H}"
